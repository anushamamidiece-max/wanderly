# Copy this file to `.env` and fill in your own keys.
# The app runs without them (it falls back to keyless services),
# but these unlock the full experience.

# Google Gemini — AI chat + itinerary generation
# https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# OpenWeather — live weather (falls back to Open-Meteo without a key)
# https://openweathermap.org/api
VITE_OPENWEATHER_API_KEY=

# Unsplash — dynamic destination imagery (falls back to Wikipedia/Unsplash CDN)
# https://unsplash.com/developers
VITE_UNSPLASH_ACCESS_KEY=
